DATABASE_URL=postgres://barbearia:barbearia@localhost:5433/barbearia
# Banco exclusivo da suíte de testes: ela trunca todas as tabelas a cada teste e
# por isso nunca roda contra o banco de desenvolvimento.
DATABASE_URL_TEST=postgres://barbearia:barbearia@localhost:5433/barbearia_test
# Os três segredos abaixo precisam ser gerados por você — o app recusa subir
# enquanto estiverem com CHANGE_ME. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGE_ME
MANAGE_TOKEN_SECRET=CHANGE_ME
APP_URL=http://localhost:3000
WHATSAPP_ENABLED=false
# Obrigatórios quando WHATSAPP_ENABLED=true.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_LANGUAGE=pt_BR
CRON_SECRET=CHANGE_ME
REMINDER_WINDOW_MINUTES=180
