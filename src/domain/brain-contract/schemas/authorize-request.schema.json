{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "intent",
    "slots"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "actorProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "object",
      "properties": {
        "profileId": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^\\d+$"
            }
          ]
        }
      }
    }
  }
}
